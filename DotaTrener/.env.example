# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=dotatrener_db
DB_USER=DotaTrener_user
# Замените на реальный пароль пользователя PostgreSQL (не оставляйте your-password)
DB_PASSWORD=your-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Stratz API (https://stratz.com/api)
STRATZ_API_KEY=your-stratz-api-key
STRATZ_API_URL=https://api.stratz.com/graphql
STRATZ_REST_URL=https://api.stratz.com/api/v1
STRATZ_PATCH_VERSION=7.38
STRATZ_REQUEST_DELAY=0.4
STRATZ_BUILDS_TAKE=100
